{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "Lua 5.1",
  "runtime.builtin": {
    "basic": "disable",
    "math": "disable",
    "os": "disable",
    "string": "disable",
    "table": "disable",
    "io": "disable",
    "package": "disable",
    "debug": "disable",
    "utf8": "disable"
  },
  "workspace.library": [
    "~/.local/share/wow-api/Annotations/Core",
    "~/.local/share/wow-framexml/Annotations",
    "~/.local/share/wow-interface-resources/Resources/LuaEnum.lua",
    "~/.local/share/wow-interface-resources/Resources/GlobalStrings/enUS.lua",
    "~/.local/share/wow-shim"
  ],
  "workspace.checkThirdParty": false,
  "workspace.ignoreDir": [
    ".release"
  ],
  "format.enable": true
}
